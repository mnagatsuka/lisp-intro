;; フィボナッチ数を素直な再帰で求める関数。
;; fib(0)=0, fib(1)=1, fib(n)=fib(n-1)+fib(n-2)
(defun fib (n)
  ;; n が 0 か 1 なら、そのまま n を返す（再帰の終了条件）。
  (if (< n 2)
      n
      ;; それ以外は直前の 2 つの値を足す。
      (+ (fib (- n 1)) (fib (- n 2)))))

;; (time ...) は実行時間やメモリ使用量を表示しつつ、式の値をそのまま返す。
;; ~a は値を見やすく出力、~% は改行。
(format t "~a~%" (time (fib 35)))
